# JomCall hosted settings: every variable, no values. NEVER commit a filled copy.
# Copy the lines a service needs into its own file on the server
# (/etc/jomcall/<service>.env, root-owned, mode 0600) or into Vercel
# (web, per environment). Staging and production get different values.
# Each variable: a comment line "[services] (secret|config) description", then NAME= with no value.

# --- Shared ---
# [web,engine,agent,voice] (config) Run mode: hosted for staging and production (Vercel previews stay mock)
JOMCALL_MODE=
# [web,engine,agent] (config) Queue label: staging or prod
JOMCALL_QUEUE_NAMESPACE=
# [web,engine,agent,release,backup] (config) Comma-separated database host names this environment may connect to
JOMCALL_DATABASE_HOSTS=
# [web,engine,agent,release,backup] (optional, config) Optional PEM certificate of the database's certificate authority (\n for newlines)
JOMCALL_DATABASE_CA=

# --- Web (Vercel) ---
# [web,engine] (config) The one https origin of this environment, e.g. https://app.example.com
APP_ORIGIN=
# [web] (config) https URL of the Supabase project
SUPABASE_URL=
# [web] (secret) Supabase anonymous (publishable) key; server-side only here
SUPABASE_ANON_KEY=
# [web] (secret) jomcall_app login through the transaction pooler
APP_DATABASE_URL=
# [web] (secret) At least 32 random characters; signs CSRF tokens
CSRF_SECRET=
# [web,engine] (secret) 64 hex characters; encrypts invitation tokens until mailed
INVITATION_KEY=
# [web,agent] (config) disabled or openrouter (typed agent tests)
JOMCALL_MODEL_PROVIDER=
# [web,agent] (optional, config) Optional hosted model ID; web and agent must agree
JOMCALL_HOSTED_MODEL=
# [web,agent] (config) disabled or hosted (browser voice tests)
JOMCALL_VOICE_PROVIDER=
# [web,voice] (conditional, config) web: public wss:// address; voice: internal ws://livekit:7880
LIVEKIT_URL=
# [web,voice] (conditional, config) LiveKit API key name (matches LIVEKIT_KEYS)
LIVEKIT_API_KEY=
# [web,voice] (conditional, secret) LiveKit API secret (matches LIVEKIT_KEYS)
LIVEKIT_API_SECRET=
# [web] (optional, config) Optional Cloudflare Turnstile site key for sign-up and login; set both Turnstile keys or neither
TURNSTILE_SITE_KEY=
# [web] (optional, secret) Optional Turnstile secret key, verified server-side; set both Turnstile keys or neither
TURNSTILE_SECRET_KEY=

# --- Engine worker ---
# [engine] (secret) jomcall_worker login, session connection
WORKER_DATABASE_URL=
# [engine,agent] (secret) jomcall_queue login, session connection (never the transaction pooler)
QUEUE_DATABASE_URL=
# [engine] (optional, config) Optional: smtp (default) or cloudflare (Cloudflare Email Service REST API)
JOMCALL_MAIL_PROVIDER=
# [engine,backup] (conditional, config) 32-hex Cloudflare account ID (email sending and the R2 endpoint)
CLOUDFLARE_ACCOUNT_ID=
# [engine] (conditional, secret) API token with only "Email Sending: Edit" (when JOMCALL_MAIL_PROVIDER=cloudflare)
CLOUDFLARE_EMAIL_API_TOKEN=
# [engine] (conditional, config) Sender address on the onboarded domain, e.g. hello@example.com (when cloudflare)
CLOUDFLARE_EMAIL_FROM=
# [engine] (conditional, config) Email provider SMTP host (when JOMCALL_MAIL_PROVIDER=smtp)
SMTP_HOST=
# [engine] (conditional, config) 465 (TLS) or 587 (STARTTLS)
SMTP_PORT=
# [engine] (conditional, config) SMTP login name
SMTP_USER=
# [engine] (conditional, secret) SMTP password or API key
SMTP_PASSWORD=
# [engine] (conditional, config) Sender, e.g. JomCall <hello@example.com> (SPF/DKIM set up)
SMTP_FROM=

# --- Agent worker ---
# [agent] (secret) jomcall_agent login, session connection
AGENT_DATABASE_URL=
# [agent] (conditional, secret) Typed-test model key (when JOMCALL_MODEL_PROVIDER=openrouter)
OPENROUTER_API_KEY=
# [agent] (conditional, secret) Spoken-path model key (when JOMCALL_VOICE_PROVIDER=hosted)
ANTHROPIC_API_KEY=
# [agent] (conditional, config) Agent container's own private address, e.g. 172.30.0.10
JOMCALL_VOICE_BIND=
# [agent,voice] (conditional, secret) At least 32 random characters, same value in agent and voice
JOMCALL_VOICE_SERVICE_SECRET=

# --- Voice worker ---
# [voice] (config) Agent turn endpoint on the private network, e.g. http://172.30.0.10:54633
JOMCALL_VOICE_TURN_URL=
# [voice] (secret) Speech to text key
DEEPGRAM_API_KEY=
# [voice] (secret) Text to speech key
GOOGLE_CLOUD_API_KEY=
# [voice] (optional, config) Filler audio cache directory (set by Compose to a volume)
JOMCALL_VOICE_CACHE_DIR=
# [voice] (optional, config) Stage timing directory (set by Compose to a volume)
JOMCALL_VOICE_STAGES_DIR=

# --- Phone line (opt-in; off unless JOMCALL_TELEPHONY_PROVIDER=livekit_sip) ---
# [web,agent] (optional, config) Optional: disabled (default) or livekit_sip; needs hosted voice, and LIVEKIT_URL, LIVEKIT_API_KEY and LIVEKIT_API_SECRET in agent.env too
JOMCALL_TELEPHONY_PROVIDER=
# [agent] (optional, config) Optional transfer target template with {e164}; default tel:{e164}
JOMCALL_SIP_TRANSFER_URI=
# [agent] (optional, config) Optional: live phone calls at once, 1 to 20; default 1
JOMCALL_MAX_CONCURRENT_CALLS=
# [agent] (optional, config) Optional: longest phone call in seconds, 60 to 3600; default 600
JOMCALL_CALL_CAP_SECONDS=
# [voice] (optional, config) Agent phone endpoint on the private network (set by Compose to http://172.30.0.10:54635)
JOMCALL_PHONE_URL=

# --- LiveKit (livekit.env) ---
# [livekit] (secret) "<api key>: <api secret>" for the LiveKit server
LIVEKIT_KEYS=

# --- Caddy (caddy.env) ---
# [caddy] (config) Public host name for LiveKit, e.g. livekit.example.com (DNS A record to the server)
LIVEKIT_DOMAIN=
# [caddy] (config) Email Caddy gives the certificate authority
ACME_EMAIL=

# --- Release job (owner only; never on a service) ---
# [release,backup] (config) staging or prod; must equal the --target given to the migration runner or backup job
HOSTED_TARGET=
# [release] (secret) postgres admin login, session connection; never given to a service
HOSTED_ADMIN_DATABASE_URL=
# [release] (secret) 64 hex characters for jomcall_app
HOSTED_APP_PASSWORD=
# [release] (secret) 64 hex characters for jomcall_worker
HOSTED_WORKER_PASSWORD=
# [release] (secret) 64 hex characters for jomcall_queue
HOSTED_QUEUE_PASSWORD=
# [release] (secret) 64 hex characters for jomcall_agent
HOSTED_AGENT_PASSWORD=

# --- Backup job (nightly encrypted dump to R2, owner's host) ---
# [backup] (config) 1 to allow the backup job to run (anything else refuses)
BACKUP_ENABLED=
# [backup] (secret) Login that may read every table (session connection, TLS); never given to a service
BACKUP_DATABASE_URL=
# [backup] (secret) 64 hex characters; AES-256-GCM key, kept offline too: without it no dump can be restored
BACKUP_ENCRYPTION_KEY=
# [backup] (config) R2 bucket name for dumps, e.g. jomcall-backups-staging
R2_BUCKET=
# [backup] (config) R2 API token Access Key ID (Object Read & Write, this bucket only)
R2_ACCESS_KEY_ID=
# [backup] (secret) R2 API token Secret Access Key
R2_SECRET_ACCESS_KEY=
