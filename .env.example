# Generated locally by npm run local:start. Never paste real provider credentials.
SUPABASE_URL=http://127.0.0.1:54621
SUPABASE_ANON_KEY=
APP_DATABASE_URL=
LOCAL_ORIGIN=http://127.0.0.1:4182
INVITATION_KEY=
CSRF_SECRET=
JOMCALL_QUEUE_NAMESPACE=local
LOCAL_ADMIN_DATABASE_URL=
SUPABASE_SERVICE_KEY=
LOCAL_APP_PASSWORD=
LOCAL_WORKER_PASSWORD=
LOCAL_QUEUE_PASSWORD=
WORKER_DATABASE_URL=
QUEUE_DATABASE_URL=
SMTP_HOST=127.0.0.1
SMTP_PORT=54625
# WhatsApp channel. Off unless set. disabled | fake | cloud. "cloud" calls Meta
# and is not approved yet; "fake" keeps everything on this machine.
JOMCALL_WHATSAPP_PROVIDER=disabled
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# 64 hex characters; seals each business's access token. Required for cloud.
WHATSAPP_CREDENTIALS_KEY=
# Payments (billing) are off by default and are not read from this file.
# Put payment settings in the gitignored .env.payments (only the web app and
# billing:reconcile read it); see docs/research/payment-providers-malaysia.md.
# Simulated payments: npm run dev:local:fake-payments
